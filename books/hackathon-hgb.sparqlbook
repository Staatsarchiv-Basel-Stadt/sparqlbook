[
  {
    "kind": 2,
    "language": "sparql",
    "value": "# from file queries/hackathon-hgb-01.rq\r\n\r\n\r\n# [endpoint=https://ld.bs.ch/query]\r\nPREFIX void: <http://rdfs.org/ns/void#>\r\nPREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>\r\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r\nPREFIX schema: <http://schema.org/>\r\nPREFIX dcterms: <http://purl.org/dc/terms/>\r\nPREFIX rico: <https://www.ica.org/standards/RiC/ontology#>\r\nPREFIX stabs-acr: <https://ld.bs.ch/RiC/vocabularies/acRules/>\r\n\r\nSELECT ?r ?title ?signatur ?date ?viewer ?iiif\r\nWHERE {\r\n  GRAPH <https://ld.bs.ch/graph/ais-metadata> \r\n  {\r\n    {?i a rico:Instantiation ;\r\n        rico:isOrWasDigitalInstantiationOf ?r .\r\n    }\r\n    ?r rico:isAssociatedWithRule stabs-acr:free-online ;\r\n       rico:title ?title ;\r\n       rico:type ?archivalienart ;\r\n       rico:identifier ?signatur ;\r\n       rico:isAssociatedWithDate/rico:expressedDate ?date\r\n       .\r\n    filter(regex(?title, 'Petersgraben'))\r\n    filter(regex(?archivalienart, 'Bild'))\r\n    ?i rdfs:seeAlso ?viewer ;\r\n       schema:url ?iiif\r\n       .\r\n  }\r\n}\r\nLIMIT 100",
    "metadata": {
      "file": "queries/hackathon-hgb-01.rq"
    }
  }
]